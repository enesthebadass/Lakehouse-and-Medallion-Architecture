# Docker Compose user mapping
AIRFLOW_UID=50000

# Synthetic operational source database (local development only)
CORE_BANKING_DB_USER=core_banking
CORE_BANKING_DB_PASSWORD=change-me-for-local-development
CORE_BANKING_DB_NAME=core_banking
CORE_BANKING_DB_PORT=5433

# Local CDC credentials and host ports
CDC_DB_USER=debezium
CDC_DB_PASSWORD=change-me-for-local-development
CDC_TOPIC_PREFIX=bank.core
BRONZE_CDC_TOPIC_PATTERN=^bank\.core\.(mms|MMS|krd|KRD|prm|PRM)\..+$
KAFKA_HOST_PORT=29092
KAFKA_CONNECT_HOST_PORT=8083
HIVE_METASTORE_HOST_PORT=9083
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=hive_metastore_local
HIVE_METASTORE_DB_NAME=metastore
TRINO_HOST_PORT=8082

# Optional local observability profile
PIPELINE_METRICS_HOST_PORT=9108
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-for-local-development

# Optional OpenMetadata governance profile (local development only)
OPENMETADATA_HOST_PORT=8585
OPENMETADATA_ADMIN_HOST_PORT=8586
OPENMETADATA_POSTGRES_PASSWORD=change-me-for-local-development
OPENMETADATA_FERNET_KEY=jJ/9sz0g0OHxsfxOoSfdFdmk3ysNmPRnH3TUAbz3IHA=
OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms1G
# Generate this from Settings > Bots > ingestion-bot; never commit the real token.
OPENMETADATA_JWT_TOKEN=replace-with-local-ingestion-bot-token

# Deterministic operational workload defaults
WORKLOAD_SEED=42
WORKLOAD_BASE_DATE=2026-01-15
