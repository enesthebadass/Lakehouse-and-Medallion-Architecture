{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "core-banking-source",
  "database.port": "5432",
  "database.user": "__INJECTED_AT_REGISTRATION__",
  "database.password": "__INJECTED_AT_REGISTRATION__",
  "database.dbname": "__INJECTED_AT_REGISTRATION__",
  "topic.prefix": "__INJECTED_AT_REGISTRATION__",
  "plugin.name": "pgoutput",
  "slot.name": "lakehouse_cdc_slot",
  "slot.drop.on.stop": "false",
  "publication.name": "lakehouse_cdc_publication",
  "publication.autocreate.mode": "disabled",
  "schema.include.list": "mms,krd,prm",
  "table.include.list": "mms\\.(customers|customer_addresses|customer_contacts|customer_relations),krd\\.(loan_applications|loans|installments|collaterals),prm\\.(currencies|branches|products|status_codes|rate_parameters)",
  "snapshot.mode": "initial",
  "include.schema.changes": "false",
  "provide.transaction.metadata": "true",
  "heartbeat.interval.ms": "10000",
  "decimal.handling.mode": "string",
  "time.precision.mode": "isostring",
  "tombstones.on.delete": "false",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "delete",
  "topic.creation.default.retention.ms": "604800000",
  "errors.tolerance": "none"
}
